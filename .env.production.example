# =============================================================================
# TMA — Production Environment Configuration (.env.production)
# Copy to `.env.production` on your production server and fill in real values.
# NEVER commit the real .env.production to GitHub.
# =============================================================================

# --- Flask Core Production ---
FLASK_APP=app:create_app
FLASK_ENV=production
FLASK_DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_64_character_hex_string_here

# --- Domain & Platform Routing ---
# Your registered domain
BASE_DOMAIN=abhishekpathak.site
# The exact host where the Platform Super-Admin console lives
PLATFORM_ADMIN_HOST=tma.abhishekpathak.site
TENANT_ZERO_SUBDOMAIN=tma.tenant0
SESSION_COOKIE_SECURE=True
PERMANENT_SESSION_LIFETIME_HOURS=24

# --- Production PostgreSQL Database ---
POSTGRES_USER=tma_admin
POSTGRES_PASSWORD=use_a_very_strong_password_here_123!
POSTGRES_DB=tma_production
DATABASE_URL=postgresql://tma_admin:use_a_very_strong_password_here_123!@db:5432/tma_production

# --- Initial Platform Operator Super-Admin Account ---
PLATFORM_ADMIN_NAME=Platform Owner
PLATFORM_ADMIN_EMAIL=owner@yourdomain.com
PLATFORM_ADMIN_PASSWORD=SetAStrongSuperAdminPassword123!

# --- Hashids Obfuscation ---
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
HASHIDS_SALT=generate_a_random_salt_string_here
HASHIDS_MIN_LENGTH=8

# --- Razorpay Live Credentials (P9 Marketplace Settlement) ---
# Obtain from your Razorpay Dashboard in LIVE mode
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_live_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_razorpay_dashboard
# Your platform commission percentage (e.g. 5 for 5%)
RAZORPAY_PLATFORM_COMMISSION_PERCENT=5
GST_RATE_PERCENT=18

# --- Email Provider (P11) ---
# Options: sendgrid | smtp | ses
EMAIL_PROVIDER=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WhatsApp Cloud API (P11) ---
WHATSAPP_PROVIDER=meta_cloud_api
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token_123
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_TEMPLATE_LANG=en_US

# --- SMS & Twilio Fallback ---
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# --- Google OAuth 2.0 (Sign in with Google) ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# --- File Storage & Uploads ---
MEDIA_STORAGE_PATH=instance/uploads
MEDIA_MAX_UPLOAD_MB=10
