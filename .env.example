# =============================================================================
# TMA — Environment Variable Template (TDR §16)
# Copy to `.env` and fill in real/local values. `.env` must be git-ignored.
# =============================================================================

# --- Flask core ---
FLASK_APP=app:create_app
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=change-me-in-real-deployments

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://tma:tma_dev_password@db:5432/tma_platform
TEST_DATABASE_URL=postgresql://tma:tma_dev_password@db_test:5432/tma_platform_test

# --- Mail / OTP (MailHog locally) ---
MAIL_SERVER=mailhog
MAIL_PORT=1025
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@tma.local
RESET_TOKEN_EXPIRY_MINUTES=30

# --- Razorpay (sandbox/test mode, TDR §8.2) ---
RAZORPAY_KEY_ID=rzp_test_TM7ClbOrh6vEOZ
RAZORPAY_KEY_SECRET=ai5dKPr4zjxj46IBL8sO3JHL
RAZORPAY_WEBHOOK_SECRET=my_trek_webhook_secret_123

# --- Admin seed (flask seed-admin) ---
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@tma.local
ADMIN_PASSWORD=change-me-admin-password

# --- Ticket retention (days) ---
QUERY_TICKET_RETENTION_DAYS=10
PROBLEM_TICKET_RETENTION_DAYS=90

# --- Stale-booking expiry ---
STALE_BOOKING_EXPIRY_MINUTES=30
STALE_BOOKING_SWEEP_MINUTES=15

# --- Session / security ---
SESSION_COOKIE_SECURE=False
PERMANENT_SESSION_LIFETIME_HOURS=12

# --- Rate limiting (Flask-Limiter) ---
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=5 per minute
FORGOT_PASSWORD_RATE_LIMIT=5 per minute
RESET_PASSWORD_RATE_LIMIT=5 per minute

# --- Scheduler ---
SCHEDULER_API_ENABLED=False
TICKET_PURGE_CRON_HOUR=2

# --- Web server (container) ---
WEB_HOST=0.0.0.0
WEB_PORT=5000

# --- TMA Platform v2 (P7) ---
HASHIDS_SALT=change-me-per-deployment
HASHIDS_MIN_LENGTH=8
REDIS_URL=
BASE_DOMAIN=localhost
PLATFORM_ADMIN_HOST=platform.localhost
TENANT_ZERO_NAME=Tenant Zero Treks
TENANT_ZERO_SUBDOMAIN=tenantzero
ADMIN_MOBILE_COUNTRY_CODE=+91
ADMIN_MOBILE_NUMBER=9999999999
DEFAULT_MOBILE_REGION=IN

# --- TMA Platform v2 (P8) ---
PLATFORM_ADMIN_NAME=Platform Owner
PLATFORM_ADMIN_EMAIL=owner@platform.local
PLATFORM_ADMIN_PASSWORD=change-me-platform-password

# --- TMA Platform v2 (P9) ---
RAZORPAY_PLATFORM_ACCOUNT_ID=acc_xxxxxxxxxxxx
RAZORPAY_PLATFORM_COMMISSION_PERCENT=
RAZORPAY_ROUTE_WEBHOOK_SECRET=
REQUIRE_ROUTE_LINKAGE=false
GST_RATE_PERCENT=
WAITLIST_OFFER_WINDOW_MINUTES=120